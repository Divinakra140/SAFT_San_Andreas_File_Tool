<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinForms instead of WPF: WPF's DirectX/DirectWrite-based rendering is poorly supported under
    Wine (and therefore Winlator, the Wine-based Windows-PC-emulation layer some Android handheld
    users run this alongside GTA SA itself in). WinForms renders through GDI/GDI+, a much older,
    far more thoroughly Wine-tested API — a self-contained single-file WinForms exe built exactly
    like this one was confirmed to run correctly in a real Winlator container, where an equivalent
    WPF exe did not. Functionally this is a straight port: same four tabs, same SAFT.Core calls,
    same confirmations/warnings — only the UI toolkit and hand-approximated branding changed.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\SAFT.ico</ApplicationIcon>
    <AssemblyName>SAFT</AssemblyName>
    <RootNamespace>SAFT.App</RootNamespace>
    <!-- Shows up in the exe's Properties > Details, so a downloaded copy can be identified on
         sight. Keep in step with the window title in MainForm.Layout.cs and the GitHub release tag. -->
    <Version>2.1.3</Version>

    <!--
      Compile ahead of time instead of at runtime.

      An Android bug report taken at the moment of a crash showed what SAFT actually does on that
      platform: 519 separate "execute" grants from the .NET tiered compilation threads, each one the
      JIT writing machine code into a temp mapping inside the wineserver directory and asking to run
      it. Android forbids writing and executing the same memory, so every method compiled at runtime
      becomes a file mapping, a permission check, and a remap - through Wine, on a translation layer
      that is itself turning x86 into ARM.

      The same report ruled out everything else: no low-memory kill, no phantom-process trim, no
      tombstone, no signal. Android never killed SAFT - the process simply ended, 33 milliseconds
      after its last log line. A JIT that cannot map executable memory takes a process down exactly
      like that: instantly, with no managed exception for the runtime to report.

      ReadyToRun precompiles the IL to native code at build time, so the overwhelming majority of
      methods are ready to run as they are and the JIT is left with far less to do. Costs about
      10% more file size, which for a tool downloaded once is nothing.

      HONEST RESULT: this did what it claimed and did NOT fix the crashes. Measured in Android bug
      reports taken at the moment of death, execute-grants for runtime-compiled code fell from 519 a
      session to 358, and to 147 when tiered recompilation was also disabled - and the process still
      died, sooner, somewhere else entirely. Disabling tiering was reverted for that reason: no
      evidence of benefit, and it makes the first call to anything without precompiled code slower.
      ReadyToRun is kept only because doing less work at runtime is defensible on its own; it is not
      a fix and should not be described as one.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>

    <Product>SAFT — San Andreas File Tool</Product>
    <Company>Divinakra</Company>
  </PropertyGroup>

  <!--
    Two exes, one source tree. Publish with -p:ModDev=true for the developer edition.

    A compile-time switch rather than two projects, because almost every bug found while testing 2.0
    appeared on exactly one platform: two diverging copies would have meant fixing each twice and
    eventually remembering only once. See Edition.cs for what actually differs.
  -->
  <PropertyGroup Condition="'$(ModDev)' == 'true'">
    <DefineConstants>$(DefineConstants);MODDEV</DefineConstants>
    <AssemblyName>SAFT-Dev</AssemblyName>
    <Product>SAFT Dev — San Andreas File Tool</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAFT.Core\SAFT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Embedded (not just Content) so every image is baked into the single-file publish itself —
      the exe needs no external image files or folders sitting next to it at runtime. Loaded at
      runtime via EmbeddedImages.Load(logicalName), matched to the LogicalName below.
    -->
    <EmbeddedResource Include="..\..\assets\panel\logo.png"><LogicalName>SAFT.Assets.panel.logo.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\by_line1.png"><LogicalName>SAFT.Assets.panel.by_line1.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\by_line2.png"><LogicalName>SAFT.Assets.panel.by_line2.png</LogicalName></EmbeddedResource>
    <!--
      PNG, not the original clouds_giant.jpg — Wine's GDI+ (libgdiplus) JPEG decoding has a real
      history of being unreliable/producing solid-black output on some builds, which is a strong
      suspect for the black window seen in a Winlator container; PNG decoding is far more
      consistently supported. Same source photo, just re-encoded losslessly.
    -->
    <EmbeddedResource Include="..\..\assets\panel\clouds_giant.png"><LogicalName>SAFT.Assets.clouds_panel_bg.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\models.png"><LogicalName>SAFT.Assets.panel.models.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\collision.png"><LogicalName>SAFT.Assets.panel.collision.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\textures.png"><LogicalName>SAFT.Assets.panel.textures.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\animations.png"><LogicalName>SAFT.Assets.panel.animations.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\audio.png"><LogicalName>SAFT.Assets.panel.audio.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\map_data.png"><LogicalName>SAFT.Assets.panel.map_data.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\paths.png"><LogicalName>SAFT.Assets.panel.paths.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\data_tables.png"><LogicalName>SAFT.Assets.panel.data_tables.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\text.png"><LogicalName>SAFT.Assets.panel.text.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\cutscenes.png"><LogicalName>SAFT.Assets.panel.cutscenes.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\particle_effects.png"><LogicalName>SAFT.Assets.panel.particle_effects.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\title_bold.png"><LogicalName>SAFT.Assets.panel.title_bold.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\modify.png"><LogicalName>SAFT.Assets.panel.modify.png</LogicalName></EmbeddedResource>
  </ItemGroup>

  <!--
    A 32-bit process gets 2 GB of address space by default, and 4 GB if this flag is set and the host
    is 64-bit - which every machine SAFT runs on is. What runs out during the pre-install analysis is
    contiguous address space, not memory, so this is real headroom. See the script for the full
    reasoning, including why it is a mitigation rather than a fix.
  -->
  <Target Name="SetLargeAddressAware" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <Exec Command="python3 &quot;$(MSBuildThisFileDirectory)..\..\build\set-large-address-aware.py&quot; &quot;$(PublishDir)$(AssemblyName).exe&quot;" />
  </Target>

</Project>
