<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WinForms instead of WPF: WPF's DirectX/DirectWrite-based rendering is poorly supported under
    Wine (and therefore Winlator, the Wine-based Windows-PC-emulation layer some Android handheld
    users run this alongside GTA SA itself in). WinForms renders through GDI/GDI+, a much older,
    far more thoroughly Wine-tested API — a self-contained single-file WinForms exe built exactly
    like this one was confirmed to run correctly in a real Winlator container, where an equivalent
    WPF exe did not. Functionally this is a straight port: same four tabs, same SAFT.Core calls,
    same confirmations/warnings — only the UI toolkit and hand-approximated branding changed.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\SAFT.ico</ApplicationIcon>
    <AssemblyName>SAFT</AssemblyName>
    <RootNamespace>SAFT.App</RootNamespace>
    <!-- Shows up in the exe's Properties > Details, so a downloaded copy can be identified on
         sight. Keep in step with the window title in MainForm.Layout.cs and the GitHub release tag. -->
    <Version>1.6.0</Version>
    <Product>SAFT — San Andreas File Tool</Product>
    <Company>Divinakra</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SAFT.Core\SAFT.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Embedded (not just Content) so every image is baked into the single-file publish itself —
      the exe needs no external image files or folders sitting next to it at runtime. Loaded at
      runtime via EmbeddedImages.Load(logicalName), matched to the LogicalName below.
    -->
    <EmbeddedResource Include="..\..\assets\icon_s.png"><LogicalName>SAFT.Assets.icon_s.png</LogicalName></EmbeddedResource>
    <!--
      PNG, not the original clouds_giant.jpg — Wine's GDI+ (libgdiplus) JPEG decoding has a real
      history of being unreliable/producing solid-black output on some builds, which is a strong
      suspect for the black window seen in a Winlator container; PNG decoding is far more
      consistently supported. Same source photo, just re-encoded losslessly.
    -->
    <EmbeddedResource Include="..\..\assets\panel\clouds_giant.png"><LogicalName>SAFT.Assets.clouds_panel_bg.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\replaces.png"><LogicalName>SAFT.Assets.panel.replaces.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\models.png"><LogicalName>SAFT.Assets.panel.models.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\collision.png"><LogicalName>SAFT.Assets.panel.collision.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\textures.png"><LogicalName>SAFT.Assets.panel.textures.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\animations.png"><LogicalName>SAFT.Assets.panel.animations.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\audio.png"><LogicalName>SAFT.Assets.panel.audio.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\map_data.png"><LogicalName>SAFT.Assets.panel.map_data.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\paths.png"><LogicalName>SAFT.Assets.panel.paths.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\data_tables.png"><LogicalName>SAFT.Assets.panel.data_tables.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\text.png"><LogicalName>SAFT.Assets.panel.text.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\cutscenes.png"><LogicalName>SAFT.Assets.panel.cutscenes.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\particle_effects.png"><LogicalName>SAFT.Assets.panel.particle_effects.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\title_wordmark.png"><LogicalName>SAFT.Assets.panel.title_wordmark.png</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="..\..\assets\panel\title_byline.png"><LogicalName>SAFT.Assets.panel.title_byline.png</LogicalName></EmbeddedResource>
  </ItemGroup>

</Project>
